{
  "name": "@golden-passport/ds-patternfly",
  "version": "0.1.1",
  "description": "Brandable React design system built on PatternFly 6, for BPM/automation projects.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoldenPassport/ds-patternfly.git"
  },
  "bugs": {
    "url": "https://github.com/GoldenPassport/ds-patternfly/issues"
  },
  "homepage": "https://github.com/GoldenPassport/ds-patternfly#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": "./dist/styles/index.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "tsup && node scripts/build-css.mjs",
    "dev": "tsup --watch",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:start": "pnpm storybook:stop && pnpm storybook",
    "storybook:stop": "lsof -tiTCP:6006 -sTCP:LISTEN 2>/dev/null | xargs -r kill -9 2>/dev/null; while lsof -iTCP:6006 -sTCP:LISTEN -n -P >/dev/null 2>&1; do sleep 0.2; done; echo \"port 6006 free\"",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:ui": "vitest",
    "test:storybook": "vitest run --project=storybook",
    "clean": "rm -rf dist storybook-static node_modules",
    "gen:component": "node scripts/gen-component-page.mjs",
    "gen:props": "node scripts/extract-props.mjs"
  },
  "peerDependencies": {
    "@patternfly/react-core": ">=6",
    "@patternfly/react-icons": ">=6",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@patternfly/patternfly": "^6.4.0",
    "@patternfly/react-core": "^6.0.0",
    "@patternfly/react-icons": "^6.0.0",
    "@storybook/addon-a11y": "^10.4.0",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-vitest": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/browser": "^4.1.5",
    "@vitest/browser-playwright": "^4.1.5",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/runner": "^4.1.5",
    "axe-core": "^4.10.0",
    "playwright": "^1.48.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "storybook": "^10.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  },
  "keywords": [
    "design-system",
    "patternfly",
    "react",
    "bpm",
    "kie",
    "golden-passport"
  ],
  "pnpm": {
    "patchedDependencies": {
      "@storybook/addon-vitest@10.4.0": "patches/@storybook__addon-vitest@10.4.0.patch"
    }
  },
  "dependencies": {
    "@patternfly/quickstarts": "6.4.0",
    "@patternfly/react-catalog-view-extension": "6.3.0",
    "@patternfly/react-charts": "8.4.1",
    "@patternfly/react-component-groups": "6.4.0",
    "@patternfly/react-console": "6.1.0",
    "@patternfly/react-data-view": "6.4.0",
    "@patternfly/react-log-viewer": "6.3.0",
    "@patternfly/react-table": "6.4.3",
    "@patternfly/react-user-feedback": "6.2.0",
    "victory": "^37.3.6"
  }
}