{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "dist",
    // Self-import alias: stories (and code blocks shown to readers) import
    // the lib by its published name, exactly as a consumer would. Storybook's
    // Vite alias (.storybook/main.ts) mirrors this — keep them in sync.
    "paths": {
      "@golden-passport/ds-patternfly": ["./src/index.ts"]
    },
    // node types for .storybook/main.ts (uses node:path / node:url to
    // resolve paths); vite/client for `?raw` source imports in stories.
    // tsup uses its own entry config so this doesn't leak into the lib
    // bundle.
    "types": ["node", "vite/client"]
  },
  "include": ["src/**/*", ".storybook/**/*", "vitest.config.ts"],
  "exclude": ["dist", "storybook-static", "node_modules"]
}
