{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "dist",
    // node types for .storybook/main.ts (uses node:path / node:url to
    // resolve paths). tsup uses its own entry config so this doesn't leak
    // into the lib bundle.
    "types": ["node"]
  },
  "include": ["src/**/*", ".storybook/**/*", "vitest.config.ts"],
  "exclude": ["dist", "storybook-static", "node_modules"]
}
